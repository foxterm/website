<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>404 - Page Not Found | FoxTerm</title>
    <meta
      name="description"
      content="The page you are looking for does not exist. Return to the FoxTerm homepage."
    />
    <meta name="robots" content="noindex, nofollow" />

    <link rel="canonical" href="https://foxterm.app/404" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content="404 - Page Not Found | FoxTerm" />
    <meta
      property="og:description"
      content="The page you are looking for does not exist."
    />
    <meta property="og:url" content="https://foxterm.app/404" />
    <meta property="og:site_name" content="FoxTerm" />
    <meta property="og:image" content="/assets/apple-touch-icon.png" />
    <meta property="og:image:width" content="180" />
    <meta property="og:image:height" content="180" />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="manifest" href="/assets/site.webmanifest" />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/assets/favicon-16x16.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/assets/favicon-32x32.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/assets/apple-touch-icon.png"
    />
    <link rel="stylesheet" href="/assets/tailwind.min.css" />
    <link rel="stylesheet" href="/assets/style.css" />
  </head>

  <body
    class="bg-zinc-950 text-zinc-100 font-sans antialiased selection:bg-fox-500 selection:text-white overflow-x-hidden"
  >
    <!-- Ambient Background Lighting -->
    <div class="fixed inset-0 w-full h-full pointer-events-none z-0">
      <div
        class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-[1200px] h-[600px] bg-fox-500/15 blur-[140px] md:blur-[180px] rounded-full z-0 transform-gpu translate-z-0"
      ></div>
      <div
        class="absolute top-1/3 -right-20 w-[400px] h-[400px] bg-fox-500/10 blur-[150px] rounded-full z-0 transform-gpu translate-z-0"
      ></div>
      <div
        class="absolute inset-0 w-full h-full opacity-20 bg-code-grid [mask-image:radial-gradient(ellipse_at_center,black_20%,transparent_80%)] [-webkit-mask-image:radial-gradient(ellipse_at_center,black_20%,transparent_80%)]"
      ></div>
    </div>

    <!-- Navigation -->
    <%- nav %>

    <main
      class="relative z-10 flex flex-col items-center justify-center min-h-[calc(100vh-10rem)] px-4 text-center"
    >
      <!-- Fox Logo Icon -->
      <div
        class="relative w-24 h-24 sm:w-28 sm:h-28 mx-auto mb-8 flex items-center justify-center group cursor-default"
      >
        <div
          class="absolute inset-0 rounded-[22.5%] bg-fox-500/20 blur-xl opacity-40 transition-opacity duration-300 ease-out group-hover:opacity-100 transform-gpu pointer-events-none"
        ></div>
        <div
          class="relative w-full h-full rounded-[22.5%] bg-gradient-to-b from-zinc-800/90 to-zinc-900/90 border border-white/10 shadow-xl shadow-black/40 backdrop-blur-xl flex items-center justify-center transition-all duration-300 ease-out group-hover:border-fox-500/50 group-hover:shadow-[0_0_24px_rgba(255,104,0,0.4)] transform-gpu overflow-hidden"
        >
          <div
            class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/25 to-transparent pointer-events-none"
          ></div>
          <span
            class="fox-logo-icon text-5xl sm:text-6xl text-fox-500 transition-all duration-300 ease-out drop-shadow-[0_2px_8px_rgba(0,0,0,0.5)] group-hover:drop-shadow-[0_0_16px_rgba(255,104,0,0.6)] transform-gpu"
          ></span>
        </div>
      </div>

      <!-- 404 Number -->
      <div
        class="text-7xl sm:text-8xl md:text-9xl font-extrabold font-mono orange-gradient-text leading-none mb-4 sm:mb-6 select-none"
      >
        404
      </div>

      <!-- Message -->
      <h1
        class="text-xl sm:text-2xl md:text-3xl font-bold tracking-tight mb-3 sm:mb-4"
      >
        <%= t["content.title.0"] %>
      </h1>
      <p
        class="text-sm sm:text-base text-zinc-400 max-w-md mx-auto mb-8 sm:mb-10 leading-relaxed"
      >
        <%= t["content.lede.0"] %>
      </p>

      <!-- Actions -->
      <div class="flex flex-col sm:flex-row items-center gap-3">
        <a
          href="/"
          class="bg-fox-500 hover:bg-fox-600 text-white font-semibold px-6 py-3 rounded-xl transition-all shadow-lg shadow-fox-500/25 flex items-center space-x-2 text-sm"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10 19l-7-7m0 0l7-7m-7 7h18"
            />
          </svg>
          <span><%= t["content.links.0.0"] %></span>
        </a>
        <a
          href="/contact"
          class="px-6 py-3 rounded-xl bg-zinc-800/60 hover:bg-zinc-700/80 border border-zinc-700 hover:border-fox-500/50 text-zinc-200 hover:text-white font-semibold text-sm transition-all duration-300"
        >
          <%= t["content.links.1.0"] %>
        </a>
      </div>
    </main>

    <!-- Footer -->
    <%- footer %>
  </body>
</html>
