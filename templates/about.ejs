<!doctype html>
<html lang="<%- htmlLang %>" class="dark scroll-smooth">
  <%- head %>

  <body
    class="bg-zinc-950 text-zinc-100 font-sans antialiased selection:bg-fox-500 selection:text-white overflow-x-hidden"
  >
    <!-- Ambient Background Lighting -->
    <div class="fixed inset-0 w-full h-full pointer-events-none z-0">
      <div
        class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-[1200px] h-[600px] bg-fox-500/15 blur-[140px] md:blur-[180px] rounded-full z-0 transform-gpu translate-z-0"
      ></div>
      <div
        class="absolute top-1/3 -right-20 w-[400px] h-[400px] bg-fox-500/10 blur-[150px] rounded-full z-0 transform-gpu translate-z-0"
      ></div>
      <div
        class="absolute inset-0 w-full h-full opacity-20 bg-code-grid [mask-image:radial-gradient(ellipse_at_center,black_20%,transparent_80%)] [-webkit-mask-image:radial-gradient(ellipse_at_center,black_20%,transparent_80%)]"
      ></div>
    </div>

    <!-- Navigation -->
    <%- nav %>

    <!-- Main Content -->
    <main class="relative z-10 max-w-3xl mx-auto px-4 sm:px-6 py-12 sm:py-20">
      <!-- Hero -->
      <div class="mb-14 text-left">
        <div
          class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-fox-500/10 border border-fox-500/20 text-fox-500 text-xs font-mono font-medium mb-6"
        >
          <span
            class="w-1.5 h-1.5 rounded-full bg-fox-500 animate-pulse"
          ></span>
          <span><%= t["content.badge.0"] %></span>
        </div>
        <h1
          class="text-3xl sm:text-5xl font-extrabold tracking-tight mb-5 text-white"
        >
          <%= t["content.title.0"] %>
          <br /><span class="orange-gradient-text"
            ><%= t["content.title.1"] %></span
          >
        </h1>
        <p class="text-zinc-400 text-base sm:text-lg leading-relaxed max-w-2xl">
          <%= t["content.lede.0"] %>
        </p>
      </div>

      <!-- The Origin Story -->
      <section class="mb-16">
        <div
          class="p-6 sm:p-10 rounded-3xl bg-zinc-900/50 border border-zinc-800 backdrop-blur-xl relative overflow-hidden shadow-2xl"
        >
          <div
            class="absolute -right-10 -bottom-10 w-64 h-64 bg-fox-500/10 blur-[90px] rounded-full pointer-events-none"
          ></div>

          <div
            class="text-fox-500 font-mono font-bold text-xs mb-4 tracking-widest"
          >
            <%= t["content.sections.0.label.0"] %>
          </div>
          <h2 class="text-xl sm:text-2xl font-bold text-white mb-4">
            <%= t["content.sections.0.title.0"] %>
          </h2>
          <div
            class="space-y-4 text-zinc-300 text-sm sm:text-base leading-relaxed"
          >
            <p><%= t["content.sections.0.body.0"] %></p>
            <p><%= t["content.sections.0.body.1"] %></p>
            <p class="text-zinc-400 italic border-l-2 border-fox-500/40 pl-4">
              <%= t["content.sections.0.body.2"] %>
            </p>
          </div>
        </div>
      </section>

      <!-- Philosophy Grid -->
      <section class="mb-16">
        <div
          class="text-fox-500 font-mono font-bold text-xs mb-6 tracking-widest"
        >
          <%= t["content.sections.1.label.0"] %>
        </div>
        <h2 class="text-xl sm:text-2xl font-bold text-white mb-8">
          <%= t["content.sections.1.title.0"] %>
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div
            class="p-6 rounded-2xl bg-zinc-900/40 border border-zinc-800/70 backdrop-blur-xl group hover:border-fox-500/40 hover:-translate-y-0.5 hover:shadow-[0_0_24px_-8px_rgba(255,104,0,0.35)] transition-all duration-300"
          >
            <div
              class="w-10 h-10 rounded-xl bg-fox-500/10 border border-fox-500/25 flex items-center justify-center text-fox-500 mb-4 shadow-[0_0_15px_rgba(255,104,0,0.15)]"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z"
                ></path>
              </svg>
            </div>
            <h3 class="font-bold text-white text-sm mb-2">
              <%= t["content.sections.1.subsections.0.title.0"] %>
            </h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
              <%= t["content.sections.1.body.0"] %>
            </p>
          </div>

          <div
            class="p-6 rounded-2xl bg-zinc-900/40 border border-zinc-800/70 backdrop-blur-xl group hover:border-fox-500/40 hover:-translate-y-0.5 hover:shadow-[0_0_24px_-8px_rgba(255,104,0,0.35)] transition-all duration-300"
          >
            <div
              class="w-10 h-10 rounded-xl bg-fox-500/10 border border-fox-500/25 flex items-center justify-center text-fox-500 mb-4 shadow-[0_0_15px_rgba(255,104,0,0.15)]"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M16.5 10.5V6.75a4.5 4.5 0 00-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"
                ></path>
              </svg>
            </div>
            <h3 class="font-bold text-white text-sm mb-2">
              <%= t["content.sections.1.subsections.1.title.0"] %>
            </h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
              <%= t["content.sections.1.body.1"] %>
            </p>
          </div>

          <div
            class="p-6 rounded-2xl bg-zinc-900/40 border border-zinc-800/70 backdrop-blur-xl group hover:border-fox-500/40 hover:-translate-y-0.5 hover:shadow-[0_0_24px_-8px_rgba(255,104,0,0.35)] transition-all duration-300"
          >
            <div
              class="w-10 h-10 rounded-xl bg-fox-500/10 border border-fox-500/25 flex items-center justify-center text-fox-500 mb-4 shadow-[0_0_15px_rgba(255,104,0,0.15)]"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"
                ></path>
              </svg>
            </div>
            <h3 class="font-bold text-white text-sm mb-2">
              <%= t["content.sections.1.subsections.2.title.0"] %>
            </h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
              <%= t["content.sections.1.body.2"] %>
            </p>
          </div>

          <div
            class="p-6 rounded-2xl bg-zinc-900/40 border border-zinc-800/70 backdrop-blur-xl group hover:border-fox-500/40 hover:-translate-y-0.5 hover:shadow-[0_0_24px_-8px_rgba(255,104,0,0.35)] transition-all duration-300"
          >
            <div
              class="w-10 h-10 rounded-xl bg-fox-500/10 border border-fox-500/25 flex items-center justify-center text-fox-500 mb-4 shadow-[0_0_15px_rgba(255,104,0,0.15)]"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"
                ></path>
              </svg>
            </div>
            <h3 class="font-bold text-white text-sm mb-2">
              <%= t["content.sections.1.subsections.3.title.0"] %>
            </h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
              <%= t["content.sections.1.body.3"] %>
            </p>
          </div>
        </div>
      </section>

      <!-- Tech Stack -->
      <section class="mb-16">
        <div
          class="text-fox-500 font-mono font-bold text-xs mb-6 tracking-widest"
        >
          <%= t["content.sections.2.label.0"] %>
        </div>
        <h2 class="text-xl sm:text-2xl font-bold text-white mb-8">
          <%= t["content.sections.2.title.0"] %>
        </h2>

        <div
          class="p-6 sm:p-8 rounded-3xl bg-zinc-900/50 border border-zinc-800 backdrop-blur-xl relative overflow-hidden shadow-2xl"
        >
          <div
            class="absolute -left-10 -top-10 w-64 h-64 bg-fox-500/8 blur-[90px] rounded-full pointer-events-none"
          ></div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-5">
            <div>
              <div
                class="text-[10px] font-mono text-zinc-500 uppercase tracking-widest mb-1"
              >
                <%= t["content.sections.2.specs.0.label.0"] %>
              </div>
              <div class="text-sm text-white font-semibold">
                <%= t["content.sections.2.specs.0.value.0"] %>
              </div>
            </div>
            <div>
              <div
                class="text-[10px] font-mono text-zinc-500 uppercase tracking-widest mb-1"
              >
                <%= t["content.sections.2.specs.1.label.0"] %>
              </div>
              <div class="text-sm text-white font-semibold">
                <%= t["content.sections.2.specs.1.value.0"] %>
              </div>
            </div>
            <div>
              <div
                class="text-[10px] font-mono text-zinc-500 uppercase tracking-widest mb-1"
              >
                <%= t["content.sections.2.specs.2.label.0"] %>
              </div>
              <div class="text-sm text-white font-semibold">
                <%= t["content.sections.2.specs.2.value.0"] %>
              </div>
            </div>
            <div>
              <div
                class="text-[10px] font-mono text-zinc-500 uppercase tracking-widest mb-1"
              >
                <%= t["content.sections.2.specs.3.label.0"] %>
              </div>
              <div class="text-sm text-white font-semibold">
                <%= t["content.sections.2.specs.3.value.0"] %>
              </div>
            </div>
            <div>
              <div
                class="text-[10px] font-mono text-zinc-500 uppercase tracking-widest mb-1"
              >
                <%= t["content.sections.2.specs.4.label.0"] %>
              </div>
              <div class="text-sm text-white font-semibold">
                <%= t["content.sections.2.specs.4.value.0"] %>
              </div>
            </div>
            <div>
              <div
                class="text-[10px] font-mono text-zinc-500 uppercase tracking-widest mb-1"
              >
                <%= t["content.sections.2.specs.5.label.0"] %>
              </div>
              <div class="text-sm text-white font-semibold">
                <%= t["content.sections.2.specs.5.value.0"] %>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- The Developer -->
      <section class="mb-16">
        <div
          class="text-fox-500 font-mono font-bold text-xs mb-6 tracking-widest"
        >
          <%= t["content.sections.3.label.0"] %>
        </div>

        <div
          class="p-6 sm:p-10 rounded-3xl bg-zinc-900/50 border border-zinc-800 backdrop-blur-xl relative overflow-hidden shadow-2xl"
        >
          <div
            class="absolute -right-10 -bottom-10 w-64 h-64 bg-fox-500/10 blur-[90px] rounded-full pointer-events-none"
          ></div>

          <div
            class="space-y-4 text-zinc-300 text-sm sm:text-base leading-relaxed"
          >
            <p><%= t["content.sections.3.body.0"] %></p>
            <p>
              <%= t["content.sections.3.body.1"] %>
              <a
                href="/contact"
                class="text-fox-500 hover:text-fox-400 underline underline-offset-2 transition-colors"
                ><%= t["content.sections.3.links.0.0"] %></a
              ><%= t["content.sections.3.body.2"] %>
            </p>
          </div>

          <!-- Stats Row -->
          <div
            class="grid grid-cols-3 gap-4 mt-8 pt-8 border-t border-zinc-800/60"
          >
            <div class="text-center">
              <div class="text-2xl sm:text-3xl font-extrabold text-white mb-1">
                5
              </div>
              <div
                class="text-[10px] font-mono text-zinc-500 uppercase tracking-widest"
              >
                <%= t["content.sections.3.specs.0.label.0"] %>
              </div>
            </div>
            <div class="text-center">
              <div class="text-2xl sm:text-3xl font-extrabold text-white mb-1">
                2
              </div>
              <div
                class="text-[10px] font-mono text-zinc-500 uppercase tracking-widest"
              >
                <%= t["content.sections.3.specs.1.label.0"] %>
              </div>
            </div>
            <div class="text-center">
              <div class="text-2xl sm:text-3xl font-extrabold text-white mb-1">
                0
              </div>
              <div
                class="text-[10px] font-mono text-zinc-500 uppercase tracking-widest"
              >
                <%= t["content.sections.3.specs.2.label.0"] %>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section class="mb-12">
        <div
          class="p-6 sm:p-8 rounded-3xl bg-zinc-900/50 border border-zinc-800 backdrop-blur-xl relative overflow-hidden shadow-2xl text-center"
        >
          <div
            class="absolute -right-10 -bottom-10 w-64 h-64 bg-fox-500/10 blur-[90px] rounded-full pointer-events-none"
          ></div>
          <h2
            class="text-xl sm:text-2xl font-bold text-white mb-3 relative z-10"
          >
            <%= t["content.sections.4.title.0"] %>
          </h2>
          <p
            class="text-zinc-400 text-sm leading-relaxed mb-6 max-w-md mx-auto relative z-10"
          >
            <%= t["content.sections.4.body.0"] %>
          </p>
          <div
            class="flex flex-col sm:flex-row items-center justify-center gap-3 relative z-10"
          >
            <a
              href="https://apps.apple.com/app/foxterm/id6741786686"
              target="_blank"
              rel="noopener noreferrer"
              class="px-6 py-3 rounded-xl bg-fox-500 hover:bg-fox-600 border border-fox-400/30 text-white font-semibold text-sm transition-all duration-300 shadow-[0_0_20px_rgba(255,94,0,0.3)] hover:shadow-[0_0_28px_rgba(255,94,0,0.5)] active:scale-95 flex items-center gap-2"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path
                  d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"
                ></path>
              </svg>
              <span><%= t["content.sections.4.links.0.0"] %></span>
            </a>
            <a
              href="/contact"
              class="px-6 py-3 rounded-xl bg-zinc-800/60 hover:bg-zinc-700/60 border border-zinc-700/50 text-zinc-200 font-semibold text-sm transition-all duration-200 active:scale-95"
            >
              <%= t["content.sections.4.links.1.0"] %>
            </a>
          </div>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <%- footer %>

    <script src="/assets/script.js" charset="utf-8"></script>
  </body>
</html>
