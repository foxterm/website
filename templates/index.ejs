<!doctype html>
<html lang="<%- htmlLang %>" class="dark scroll-smooth">
  <%- head %>

  <body
    class="bg-zinc-950 text-zinc-100 font-sans antialiased selection:bg-fox-500 selection:text-white overflow-x-hidden"
  >
    <!-- Ambient Background Lighting -->
    <div class="fixed inset-0 w-full h-full pointer-events-none z-0">
      <div
        class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-[1200px] h-[600px] bg-fox-500/15 blur-[140px] md:blur-[180px] rounded-full z-0 transform-gpu translate-z-0"
      ></div>
      <div
        class="absolute top-1/3 -right-20 w-[400px] h-[400px] bg-fox-500/10 blur-[150px] rounded-full z-0 transform-gpu translate-z-0"
      ></div>
      <div
        class="absolute inset-0 w-full h-full opacity-20 bg-code-grid [mask-image:radial-gradient(ellipse_at_center,black_20%,transparent_80%)] [-webkit-mask-image:radial-gradient(ellipse_at_center,black_20%,transparent_80%)]"
      ></div>
    </div>

    <!-- Navigation -->
    <%- nav %>
    <main>
      <!-- Hero Section -->
      <section
        class="max-w-5xl mx-auto px-4 sm:px-6 pt-8 sm:pt-14 pb-12 sm:pb-20 text-center relative z-10"
      >
        <!-- Badge -->
        <div
          class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-fox-500/10 border border-fox-500/20 text-fox-500 text-xs font-mono font-medium mb-6 sm:mb-8"
        >
          <%= t["hero.badge.0"] %>
        </div>

        <!-- App Logo Icon -->
        <div
          class="relative w-24 h-24 sm:w-28 sm:h-28 mx-auto mb-6 flex items-center justify-center group cursor-default"
        >
          <div
            class="absolute inset-0 rounded-[22.5%] bg-fox-500/20 blur-xl opacity-40 transition-opacity duration-300 ease-out group-hover:opacity-100 transform-gpu pointer-events-none"
          ></div>
          <div
            class="relative w-full h-full rounded-[22.5%] bg-gradient-to-b from-zinc-800/90 to-zinc-900/90 border border-white/10 shadow-xl shadow-black/40 backdrop-blur-xl flex items-center justify-center transition-all duration-300 ease-out group-hover:border-fox-500/50 group-hover:shadow-[0_0_24px_rgba(255,104,0,0.4)] transform-gpu overflow-hidden"
          >
            <div
              class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/25 to-transparent pointer-events-none"
            ></div>
            <span
              class="fox-logo-icon text-5xl sm:text-6xl text-fox-500 transition-all duration-300 ease-out drop-shadow-[0_2px_8px_rgba(0,0,0,0.5)] group-hover:drop-shadow-[0_0_16px_rgba(255,104,0,0.6)] transform-gpu"
            ></span>
          </div>
        </div>

        <h1
          class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tight mb-4 sm:mb-6 leading-[1.15]"
        >
          <%= t["hero.title.0"] %>
          <span class="orange-gradient-text"><%= t["hero.title.1"] %></span><%= t["hero.title.2"] || "" %>
        </h1>

        <!-- Feature Tags -->
        <div
          class="flex flex-wrap items-center justify-center gap-1.5 sm:gap-2.5 mb-6 sm:mb-8 text-xs sm:text-sm font-mono text-zinc-400"
        >
          <span
            class="px-2.5 py-1 rounded-md bg-zinc-900/80 border border-zinc-800 text-fox-400 font-bold"
            ><%= t["hero.tags.0.0"] %></span
          >
          <span class="text-zinc-700">•</span>
          <span
            class="px-2.5 py-1 rounded-md bg-zinc-900/80 border border-zinc-800 text-fox-400 font-bold"
            ><%= t["hero.tags.1.0"] %></span
          >
          <span class="text-zinc-700">•</span>
          <span
            class="px-2.5 py-1 rounded-md bg-zinc-900/80 border border-zinc-800 text-fox-400 font-bold"
            ><%= t["hero.tags.2.0"] %></span
          >
          <span class="text-zinc-700">•</span>
          <span
            class="px-2.5 py-1 rounded-md bg-zinc-900/80 border border-zinc-800 text-fox-400 font-bold"
            ><%= t["hero.tags.3.0"] %></span
          >
          <span class="text-zinc-700">•</span>
          <span
            class="px-2.5 py-1 rounded-md bg-zinc-900/80 border border-zinc-800 text-fox-400 font-bold"
            ><%= t["hero.tags.4.0"] %></span
          >
        </div>

        <p
          class="text-base sm:text-lg md:text-xl text-zinc-300 mb-8 sm:mb-10 max-w-2xl mx-auto leading-relaxed"
        >
          <%= t["hero.subtitle.0"] %>
        </p>

        <!-- CTA Button -->
        <div class="flex items-center justify-center mb-10 sm:mb-16">
          <a
            href="#download"
            class="bg-fox-500 hover:bg-fox-600 text-white font-semibold px-7 py-3.5 rounded-xl transition-all shadow-lg shadow-fox-500/25 flex items-center space-x-3 text-sm sm:text-base"
          >
            <img
              src="/assets/apple.svg"
              alt="<%= t["hero.cta.0.alt"] %>"
              class="w-6 h-6 flex-shrink-0 brightness-0 invert object-contain"
            />
            <div class="text-left leading-tight">
              <div
                class="text-[10px] opacity-75 font-mono uppercase tracking-wider"
              >
                <%= t["hero.cta.0.caption.0"] %>
              </div>
              <div class="font-bold"><%= t["hero.cta.0.label.0"] %></div>
            </div>
          </a>
        </div>

        <!-- Terminal Window Mockup -->
        <div
          id="ft-mockup"
          class="relative mx-auto max-w-5xl rounded-xl sm:rounded-2xl bg-zinc-900/90 border border-zinc-800 shadow-[0_0_0_1px_rgba(255,94,0,0.04),0_24px_70px_-20px_rgba(0,0,0,0.9),0_0_50px_-15px_rgba(255,94,0,0.18)] overflow-hidden text-left font-mono text-xs sm:text-sm"
        >
          <!-- Window Title Bar -->
          <div
            class="bg-zinc-900/90 px-4 py-3 border-b border-zinc-800/80 flex items-center justify-between gap-3"
          >
            <div class="flex items-center gap-2.5 min-w-0">
              <div class="flex items-center gap-1.5 flex-shrink-0">
                <span class="w-3 h-3 rounded-full bg-red-500/80"></span>
                <span class="w-3 h-3 rounded-full bg-yellow-500/80"></span>
                <span class="w-3 h-3 rounded-full bg-green-500/80"></span>
              </div>
              <span
                class="fox-logo-icon text-sm text-fox-500 flex-shrink-0"
                aria-hidden="true"
              ></span>
              <span id="ft-win-title" class="text-xs text-zinc-500 truncate"
                >foxterm — root@GL-BE3600 — SSH</span
              >
            </div>
            <div class="flex items-center flex-shrink-0">
              <span
                class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md bg-fox-500/15 border border-fox-500/20 text-fox-400 text-[10px] sm:text-[11px] font-mono"
              >
                <span
                  class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"
                ></span>
                <span class="hidden sm:inline">LIVE · ZERO TELEMETRY</span>
                <span class="sm:hidden">LIVE</span>
              </span>
            </div>
          </div>

          <!-- Tool Tabs -->
          <div
            class="flex items-end gap-1 px-3 sm:px-4 pt-2 bg-zinc-900/70 border-b border-zinc-800/80"
          >
            <button
              type="button"
              data-ft-tab="ssh"
              data-ft-title="foxterm — root@GL-BE3600 — SSH"
              class="ft-tab ft-tab-active"
            >
              SSH
            </button>
            <button
              type="button"
              data-ft-tab="sftp"
              data-ft-title="foxterm — 192.168.8.1 — SFTP"
              class="ft-tab ft-tab-idle"
            >
              SFTP
            </button>
            <button
              type="button"
              data-ft-tab="vnc"
              data-ft-title="foxterm — ubuntu-focal-g3 — VNC"
              class="ft-tab ft-tab-idle"
            >
              VNC
            </button>
            <button
              type="button"
              data-ft-tab="docker"
              data-ft-title="foxterm — Ubuntu 24.04 — Docker"
              class="ft-tab ft-tab-idle"
            >
              Docker
            </button>
            <span
              class="ml-auto pb-1.5 pr-1 hidden sm:inline text-[10px] text-zinc-600"
              >4 tools · 1 window</span
            >
          </div>

          <!-- ===== SSH Panel ===== -->
          <div data-ft-panel="ssh" class="ft-panel ft-panel-active">
            <div class="relative bg-zinc-950/90 aspect-[16/10]">
              <div class="ft-skeleton absolute inset-0"></div>
              <img
                src="/assets/macos/ssh.png"
                alt="FoxTerm SSH Terminal"
                class="w-full h-full object-contain block opacity-0 transition-opacity duration-300"
                loading="eager"
                onload="this.style.opacity = '1';this.previousElementSibling.style.display = 'none';"
              />
            </div>
          </div>

          <!-- ===== SFTP Panel ===== -->
          <div data-ft-panel="sftp" class="ft-panel">
            <div class="relative bg-zinc-950/90 aspect-[16/10]">
              <div class="ft-skeleton absolute inset-0"></div>
              <img
                src="/assets/macos/sftp.png"
                alt="FoxTerm SFTP File Transfer"
                class="w-full h-full object-contain block opacity-0 transition-opacity duration-300"
                loading="lazy"
                onload="this.style.opacity = '1';this.previousElementSibling.style.display = 'none';"
              />
            </div>
          </div>

          <!-- ===== VNC Panel ===== -->
          <div data-ft-panel="vnc" class="ft-panel">
            <div class="relative bg-zinc-950/90 aspect-[16/10]">
              <div class="ft-skeleton absolute inset-0"></div>
              <img
                src="/assets/macos/vnc.png"
                alt="FoxTerm VNC Remote Desktop"
                class="w-full h-full object-contain block opacity-0 transition-opacity duration-300"
                loading="lazy"
                onload="this.style.opacity = '1';this.previousElementSibling.style.display = 'none';"
              />
            </div>
          </div>

          <!-- ===== Docker Panel ===== -->
          <div data-ft-panel="docker" class="ft-panel">
            <div class="relative bg-zinc-950/90 aspect-[16/10]">
              <div class="ft-skeleton absolute inset-0"></div>
              <img
                src="/assets/macos/docker.png"
                alt="FoxTerm Docker Container Management"
                class="w-full h-full object-contain block opacity-0 transition-opacity duration-300"
                loading="lazy"
                onload="this.style.opacity = '1';this.previousElementSibling.style.display = 'none';"
              />
            </div>
          </div>

          <!-- Connection Status Bars -->
          <div
            data-ft-bar="ssh"
            class="ft-bar ft-bar-active flex-wrap items-center gap-x-4 gap-y-1 px-4 sm:px-5 py-2 bg-zinc-900/90 border-t border-zinc-800/80 text-[10px] sm:text-[11px] text-zinc-500"
          >
            <span class="inline-flex items-center gap-1.5">
              <svg
                class="w-3 h-3 text-emerald-400/90"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="3" y="11" width="18" height="11" rx="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
              ed25519 · ENCRYPTED
            </span>
            <span>SSH-2.0-dropbear</span>
            <span class="text-emerald-400/80">↑ 25.53 KB</span>
            <span class="text-fox-400/80">↓ 97.96 KB</span>
            <span class="hidden sm:inline">0.003 ms</span>
            <span class="ml-auto hidden md:inline text-zinc-600"
              >256-COLOR · UTF-8 · METAL RENDER</span
            >
          </div>
          <div
            data-ft-bar="sftp"
            class="ft-bar flex-wrap items-center gap-x-4 gap-y-1 px-4 sm:px-5 py-2 bg-zinc-900/90 border-t border-zinc-800/80 text-[10px] sm:text-[11px] text-zinc-500"
          >
            <span class="text-zinc-400">SSH 2.0-OpenSSH_9.6p1</span>
            <span class="hidden sm:inline">Ubuntu-3ubuntu13.19</span>
            <span>4.75KB</span>
            <span class="text-emerald-400/80">↓ 10.98KB</span>
            <span class="text-fox-400/80">↑ 0.048ms</span>
            <span class="ml-auto hidden md:inline text-zinc-600"
              >SFTP · UTF-8 · Encrypted Channel</span
            >
          </div>
          <div
            data-ft-bar="vnc"
            class="ft-bar flex-wrap items-center gap-x-4 gap-y-1 px-4 sm:px-5 py-2 bg-zinc-900/90 border-t border-zinc-800/80 text-[10px] sm:text-[11px] text-zinc-500"
          >
            <span class="text-zinc-400">32519b5d9db21:</span>
            <span>75.63KB</span>
            <span class="text-emerald-400/80">840.66KiB</span>
            <span>0.003ms</span>
            <span class="ml-auto hidden md:inline-flex items-center gap-3">
              <span
                >FPS:
                <span class="text-zinc-200 font-semibold">40.98</span></span
              >
              <span class="text-zinc-400">1280 x 800</span>
            </span>
          </div>
          <div
            data-ft-bar="docker"
            class="ft-bar flex-wrap items-center gap-x-4 gap-y-1 px-4 sm:px-5 py-2 bg-zinc-900/90 border-t border-zinc-800/80 text-[10px] sm:text-[11px] text-zinc-500"
          >
            <span>SSH:2.0-OpenSSH_9.6p1 Ubuntu</span>
            <span class="text-emerald-400/80">28.53KB</span>
            <span class="text-fox-400/80">134.66KB</span>
            <span>0.006ms</span>
            <span class="ml-auto hidden md:inline text-zinc-600"
              >DOCKER · CONTAINERD · API 1.48</span
            >
          </div>
        </div>
      </section>

      <!-- Trust / Key Numbers Band -->
      <section
        class="max-w-6xl mx-auto px-4 sm:px-6 pb-4 sm:pb-6 relative z-10"
      >
        <div
          class="grid grid-cols-2 lg:grid-cols-4 gap-px overflow-hidden rounded-2xl border border-zinc-800/80 bg-zinc-800/60"
        >
          <div class="bg-zinc-950/80 px-4 py-6 sm:py-7 text-center">
            <div
              class="text-2xl sm:text-3xl font-extrabold font-mono orange-gradient-text"
            >
              <%= t["trust.items.0.value.0"] %>
            </div>
            <div
              class="mt-1.5 text-[11px] sm:text-xs text-zinc-400 leading-snug"
            >
              <%= t["trust.items.0.body.0"] %>
            </div>
          </div>
          <div class="bg-zinc-950/80 px-4 py-6 sm:py-7 text-center">
            <div
              class="text-2xl sm:text-3xl font-extrabold font-mono orange-gradient-text"
            >
              100%
            </div>
            <div
              class="mt-1.5 text-[11px] sm:text-xs text-zinc-400 leading-snug"
            >
              <%= t["trust.items.1.body.0"] %>
            </div>
          </div>
          <div class="bg-zinc-950/80 px-4 py-6 sm:py-7 text-center">
            <div
              class="text-2xl sm:text-3xl font-extrabold font-mono orange-gradient-text"
            >
              0
            </div>
            <div
              class="mt-1.5 text-[11px] sm:text-xs text-zinc-400 leading-snug"
            >
              <%= t["trust.items.2.body.0"] %>
            </div>
          </div>
          <div class="bg-zinc-950/80 px-4 py-6 sm:py-7 text-center">
            <div
              class="text-2xl sm:text-3xl font-extrabold font-mono orange-gradient-text"
            >
              1
            </div>
            <div
              class="mt-1.5 text-[11px] sm:text-xs text-zinc-400 leading-snug"
            >
              <%= t["trust.items.3.body.0"] %>
            </div>
          </div>
        </div>
      </section>

      <!-- Architecture & Design Section -->
      <section
        id="architecture"
        class="max-w-7xl mx-auto px-4 sm:px-6 py-12 sm:py-20 border-t border-zinc-900 relative"
      >
        <!-- Header -->
        <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
          <h2
            class="text-2xl sm:text-4xl font-extrabold tracking-tight mb-4 leading-tight"
          >
            <%= t["architecture.title.0"] %>
            <span class="orange-gradient-text"><%= t["architecture.title.2"] %></span><%= t["architecture.title.1"] %>
          </h2>
          <p class="text-zinc-400 text-sm sm:text-base leading-relaxed">
            <%= t["architecture.lede.0"] %>
          </p>
        </div>

        <!-- Part 1: Three Core Value Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16 sm:mb-24">
          <!-- Card 1 -->
          <div
            class="p-6 sm:p-8 rounded-2xl bg-zinc-900/40 border border-zinc-800/80 relative overflow-hidden group hover:border-fox-500/40 transition-all duration-300"
          >
            <div
              class="w-10 h-10 rounded-xl bg-fox-500/10 text-fox-500 flex items-center justify-center text-lg mb-5 font-mono"
            >
              01
            </div>
            <h3 class="text-lg font-bold mb-2 text-white">
              <%= t["architecture.cards.0.title.0"] %>
            </h3>
            <p class="text-zinc-400 text-xs sm:text-sm leading-relaxed">
              <%= t["architecture.cards.0.body.0"] %>
            </p>
          </div>

          <!-- Card 2 -->
          <div
            class="p-6 sm:p-8 rounded-2xl bg-zinc-900/40 border border-zinc-800/80 relative overflow-hidden group hover:border-fox-500/40 transition-all duration-300"
          >
            <div
              class="w-10 h-10 rounded-xl bg-fox-500/10 text-fox-500 flex items-center justify-center text-lg mb-5 font-mono"
            >
              02
            </div>
            <h3 class="text-lg font-bold mb-2 text-white">
              <%= t["architecture.cards.1.title.0"] %>
            </h3>
            <p class="text-zinc-400 text-xs sm:text-sm leading-relaxed">
              <%= t["architecture.cards.1.body.0"] %>
            </p>
          </div>

          <!-- Card 3 -->
          <div
            class="p-6 sm:p-8 rounded-2xl bg-zinc-900/40 border border-zinc-800/80 relative overflow-hidden group hover:border-fox-500/40 transition-all duration-300"
          >
            <div
              class="w-10 h-10 rounded-xl bg-fox-500/10 text-fox-500 flex items-center justify-center text-lg mb-5 font-mono"
            >
              03
            </div>
            <h3 class="text-lg font-bold mb-2 text-white"><%= t["architecture.cards.2.title.0"] %></h3>
            <p class="text-zinc-400 text-xs sm:text-sm leading-relaxed">
              <%= t["architecture.cards.2.body.0"] %>
            </p>
          </div>
        </div>

        <!-- Part 2: Design & Logo Geometry -->
        <div class="border-t border-zinc-900/80 pt-12 sm:pt-16">
          <div
            class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-stretch"
          >
            <!-- Left Column: Geometry Explanation -->
            <div class="lg:col-span-7 space-y-6">
              <div
                class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-fox-500/10 border border-fox-500/20 text-fox-500 text-xs font-mono"
              >
                <span class="w-1.5 h-1.5 rounded-full bg-fox-500"></span>
                <%= t["architecture.badge.0"] %>
              </div>

              <h3
                class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white leading-tight"
              >
                <%= t["architecture.cards.0.title.1"] %><br /><%= t["architecture.cards.0.title.2"] %>
                <span class="orange-gradient-text"><%= t["architecture.cards.0.title.4"] %></span><%= t["architecture.cards.0.title.3"] %>
              </h3>

              <div
                class="space-y-3 text-zinc-400 text-xs sm:text-sm leading-relaxed"
              >
                <p>
                  <%= t["architecture.cards.0.body.1"] %>
                </p>
                <p>
                  <%= t["architecture.cards.0.body.2"] %>
                  <strong class="text-zinc-200 font-semibold"
                    ><%= t["architecture.cards.0.body.3"] %></strong
                  >
                </p>
              </div>

              <!-- 4 Key Design Points -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
                <div
                  class="p-4 rounded-xl bg-zinc-900/60 border border-zinc-800/80"
                >
                  <h4
                    class="text-white font-bold text-xs mb-1 font-mono text-fox-500"
                  >
                    <%= t["architecture.cards.0.title.5"] %>
                  </h4>
                  <p class="text-zinc-400 text-xs leading-relaxed">
                    <%= t["architecture.cards.0.body.4"] %>
                  </p>
                </div>

                <div
                  class="p-4 rounded-xl bg-zinc-900/60 border border-zinc-800/80"
                >
                  <h4
                    class="text-white font-bold text-xs mb-1 font-mono text-fox-500"
                  >
                    <%= t["architecture.cards.1.title.1"] %>
                  </h4>
                  <p class="text-zinc-400 text-xs leading-relaxed">
                    <%= t["architecture.cards.1.body.1"] %>
                  </p>
                </div>

                <div
                  class="p-4 rounded-xl bg-zinc-900/60 border border-zinc-800/80"
                >
                  <h4
                    class="text-white font-bold text-xs mb-1 font-mono text-fox-500"
                  >
                    <%= t["architecture.cards.2.title.1"] %>
                  </h4>
                  <p class="text-zinc-400 text-xs leading-relaxed">
                    <%= t["architecture.cards.2.body.1"] %>
                  </p>
                </div>

                <div
                  class="p-4 rounded-xl bg-zinc-900/60 border border-zinc-800/80"
                >
                  <h4
                    class="text-white font-bold text-xs mb-1 font-mono text-fox-500"
                  >
                    <%= t["architecture.cards.3.title.0"] %>
                  </h4>
                  <p class="text-zinc-400 text-xs leading-relaxed">
                    <%= t["architecture.cards.3.body.0"] %>
                  </p>
                </div>
              </div>
            </div>

            <!-- Right Column: Logo Font Icon Display with Blueprint & Downloads -->
            <div
              class="lg:col-span-5 flex justify-center items-stretch min-h-[320px] sm:min-h-[420px]"
            >
              <div
                class="w-full h-full relative flex items-center justify-center"
              >
                <!-- Ambient Glow -->
                <div
                  class="absolute inset-0 bg-fox-500/15 rounded-3xl blur-3xl -z-10 animate-pulse"
                ></div>

                <!-- Display Box with Blueprint Overlay -->
                <div
                  class="w-full h-full border border-fox-500/30 rounded-3xl p-5 sm:p-8 bg-zinc-950/80 backdrop-blur-xl flex flex-col items-center justify-between relative overflow-hidden group"
                >
                  <!-- 1. Background Grid Pattern -->
                  <div
                    class="absolute inset-0 bg-[radial-gradient(#f97316_1px,transparent_1px)] [background-size:16px_16px] opacity-[0.07] pointer-events-none"
                  ></div>

                  <!-- 2. Geometry Blueprint Overlay -->
                  <svg
