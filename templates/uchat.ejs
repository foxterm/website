<!doctype html>
<html lang="<%- htmlLang %>" class="dark scroll-smooth">
  <%- head %>

  <body
    class="bg-zinc-950 text-zinc-100 font-sans antialiased selection:bg-fox-500 selection:text-white overflow-x-hidden"
  >
    <!-- Ambient Background Lighting -->
    <div class="fixed inset-0 w-full h-full pointer-events-none z-0">
      <div
        class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-[1200px] h-[600px] bg-sky-500/10 blur-[140px] md:blur-[180px] rounded-full z-0 transform-gpu translate-z-0"
      ></div>
      <div
        class="absolute top-1/3 -right-20 w-[400px] h-[400px] bg-fuchsia-500/10 blur-[150px] rounded-full z-0 transform-gpu translate-z-0"
      ></div>
      <div
        class="absolute inset-0 w-full h-full opacity-20 bg-code-grid [mask-image:radial-gradient(ellipse_at_center,black_20%,transparent_80%)] [-webkit-mask-image:radial-gradient(ellipse_at_center,black_20%,transparent_80%)]"
      ></div>
    </div>

    <!-- Navigation -->
    <%- nav %>
    <main>
      <!-- Hero Section -->
      <section
        class="max-w-5xl mx-auto px-4 sm:px-6 pt-8 sm:pt-14 pb-12 sm:pb-20 text-center relative z-10"
      >
        <!-- Badge -->
        <div
          class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-sky-500/10 border border-sky-500/20 text-sky-400 text-xs font-mono font-medium mb-6 sm:mb-8"
        >
          <%= t["hero.badge.0"] %>
        </div>

        <!-- App Logo -->
        <div
          class="relative w-24 h-24 sm:w-28 sm:h-28 mx-auto mb-6 flex items-center justify-center group cursor-default"
        >
          <div
            class="absolute inset-0 rounded-full bg-sky-500/20 blur-xl opacity-40 transition-opacity duration-300 ease-out group-hover:opacity-100 transform-gpu pointer-events-none"
          ></div>
          <div
            class="relative w-full h-full rounded-full bg-gradient-to-b from-zinc-800/90 to-zinc-900/90 border border-white/10 shadow-xl shadow-black/40 backdrop-blur-xl flex items-center justify-center transition-all duration-300 ease-out group-hover:border-sky-400/50 group-hover:shadow-[0_0_24px_rgba(56,189,248,0.4)] transform-gpu overflow-hidden"
          >
            <div
              class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/25 to-transparent pointer-events-none"
            ></div>
            <img
              src="/assets/ai_avatar.webp"
              alt="<%= t["hero.logoAlt.0"] %>"
              class="w-[85%] h-[85%] object-contain rounded-full transition-transform duration-300 ease-out group-hover:scale-105 transform-gpu"
            />
          </div>
        </div>

        <h1
          class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tight mb-4 sm:mb-6 leading-[1.15]"
        >
          <%= t["hero.title.0"] %>
          <span class="ai-gradient-text"><%= t["hero.title.1"] %></span>
        </h1>

        <!-- Feature Tags -->
        <div
          class="flex flex-wrap items-center justify-center gap-1.5 sm:gap-2.5 mb-6 sm:mb-8 text-xs sm:text-sm font-mono text-zinc-400"
        >
          <span
            class="px-2.5 py-1 rounded-md bg-zinc-900/80 border border-zinc-800 text-sky-400 font-bold"
            ><%= t["hero.tags.0.0"] %></span
          >
          <span class="text-zinc-700">•</span>
          <span
            class="px-2.5 py-1 rounded-md bg-zinc-900/80 border border-zinc-800 text-sky-400 font-bold"
            ><%= t["hero.tags.1.0"] %></span
          >
          <span class="text-zinc-700">•</span>
          <span
            class="px-2.5 py-1 rounded-md bg-zinc-900/80 border border-zinc-800 text-sky-400 font-bold"
            ><%= t["hero.tags.2.0"] %></span
          >
          <span class="text-zinc-700">•</span>
          <span
            class="px-2.5 py-1 rounded-md bg-zinc-900/80 border border-zinc-800 text-sky-400 font-bold"
            ><%= t["hero.tags.3.0"] %></span
          >
          <span class="text-zinc-700">•</span>
          <span
            class="px-2.5 py-1 rounded-md bg-zinc-900/80 border border-zinc-800 text-sky-400 font-bold"
            ><%= t["hero.tags.4.0"] %></span
          >
          <span class="text-zinc-700">•</span>
          <span
            class="px-2.5 py-1 rounded-md bg-zinc-900/80 border border-zinc-800 text-sky-400 font-bold"
            ><%= t["hero.tags.5.0"] %></span
          >
        </div>

        <p
          class="text-base sm:text-lg md:text-xl text-zinc-300 mb-8 sm:mb-10 max-w-2xl mx-auto leading-relaxed"
        >
          <%= t["hero.subtitle.0"] %>
        </p>

        <!-- CTA Button -->
        <div class="flex items-center justify-center mb-10 sm:mb-16">
          <a
            href="#download"
            rel="noopener noreferrer"
            class="bg-sky-500 hover:bg-sky-400 text-white font-semibold px-7 py-3.5 rounded-xl transition-all shadow-lg shadow-sky-500/25 flex items-center space-x-3 text-sm sm:text-base"
          >
            <img
              src="/assets/apple.svg"
              alt="<%= t["hero.cta.0.alt"] %>"
              class="w-8 h-8 flex-shrink-0 brightness-0 invert object-contain"
            />
            <div class="text-left leading-tight">
              <div
                class="text-[10px] opacity-75 font-mono uppercase tracking-wider"
              >
                <%= t["hero.cta.0.caption.0"] %>
              </div>
              <div class="font-bold"><%= t["hero.cta.0.label.0"] %></div>
            </div>
          </a>
        </div>

        <!-- Trust Strip -->
        <div
          class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 max-w-4xl mx-auto"
        >
          <% for (let i = 0; i < 4; i++) { %>
          <div
            class="p-4 rounded-2xl bg-zinc-900/50 border border-zinc-800/70 backdrop-blur-xl"
          >
            <div
              class="text-xl sm:text-2xl font-extrabold text-sky-400 mb-1"
            >
              <%= t["trust.items." + i + ".value.0"] %>
            </div>
            <div class="text-xs text-zinc-400 leading-relaxed">
              <%= t["trust.items." + i + ".body.0"] %>
            </div>
          </div>
          <% } %>
        </div>
      </section>

      <!-- Features Section -->
      <section
        id="features"
        class="max-w-5xl mx-auto px-4 sm:px-6 py-12 sm:py-20 relative z-10"
      >
        <div class="text-center mb-10 sm:mb-14">
          <div
            class="inline-flex items-center px-3.5 py-1.5 rounded-full bg-sky-500/10 border border-sky-500/20 text-sky-400 text-xs font-mono font-medium mb-4"
          >
            <%= t["features.badge.0"] %>
          </div>
          <h2 class="text-2xl sm:text-4xl font-bold mb-4">
            <%= t["features.title.0"] %>
          </h2>
          <p
            class="text-sm sm:text-base text-zinc-400 max-w-2xl mx-auto leading-relaxed"
          >
            <%= t["features.lede.0"] %>
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <% for (let i = 0; i < 6; i++) { %>
          <div
            class="p-6 rounded-2xl bg-zinc-900/40 border border-zinc-800/70 backdrop-blur-xl group hover:border-sky-500/40 hover:-translate-y-0.5 hover:shadow-[0_0_24px_-8px_rgba(56,189,248,0.35)] transition-all duration-300"
          >
            <div
              class="w-10 h-10 rounded-xl bg-sky-500/10 border border-sky-500/25 flex items-center justify-center text-sky-400 mb-4 shadow-[0_0_15px_rgba(56,189,248,0.15)]"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                viewBox="0 0 24 24"
              >
                <% if (i === 0) { %>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z"
                ></path>
                <% } else if (i === 1) { %>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M2.25 12.75V12A2.25 2.25 0 014.5 9.75h15A2.25 2.25 0 0121.75 12v.75m-8.25-3.75v-1.5a3 3 0 00-3-3H9a3 3 0 00-3 3v1.5m3.75 9.75l3-3m0 0l-3-3m3 3H9.75"
                ></path>
                <% } else if (i === 2) { %>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z"
                ></path>
                <% } else if (i === 3) { %>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m-18.432 0A8.959 8.959 0 013 12c0-.778.099-1.533.284-2.253"
                ></path>
                <% } else if (i === 4) { %>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M5.25 14.25h13.5m-13.5 0a3 3 0 01-3-3m3 3a3 3 0 100 6h13.5a3 3 0 100-6m-16.5-3a3 3 0 013-3h13.5a3 3 0 013 3m-19.5 0a4.5 4.5 0 01.9-2.7L5.737 5.1a3.375 3.375 0 012.7-1.35h7.126c1.062 0 2.062.5 2.7 1.35l2.587 3.45a4.5 4.5 0 01.9 2.7m0 0a3 3 0 01-3 3m0 3h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008zm-3 6h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008z"
                ></path>
                <% } else { %>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9.53 16.122a3 3 0 00-5.78 1.128 2.25 2.25 0 01-2.4 2.245 4.5 4.5 0 008.4-2.245c0-.399-.078-.78-.22-1.128zm0 0a15.998 15.998 0 003.388-1.62m-5.043-.025a15.994 15.994 0 011.622-3.395m3.42 3.42a15.995 15.995 0 004.764-4.648l3.876-5.814a1.151 1.151 0 00-1.597-1.597L14.146 6.32a15.996 15.996 0 00-4.649 4.763m3.42 3.42a6.776 6.776 0 00-3.42-3.42"
                ></path>
                <% } %>
              </svg>
            </div>
            <h3 class="font-bold text-white text-sm mb-2">
              <%= t["features.cards." + i + ".title.0"] %>
            </h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
              <%= t["features.cards." + i + ".body.0"] %>
            </p>
          </div>
          <% } %>
        </div>
      </section>

      <!-- Agent & Tools Section -->
      <section
        id="tools"
        class="max-w-5xl mx-auto px-4 sm:px-6 py-12 sm:py-20 relative z-10"
      >
        <% const toolChips = [ ["Fetch", 2], ["GeoIP", 2], ["GeoLite2", 0], ["Weather", 2], ["RDAP", 2], ["Exchange Rate", 2], ["System Info", 0], ["Current Time", 0], ["SSH", 3], ["KeyGen", 0], ["Wake-on-LAN", 1], ["Generate Image", 2] ]; %>
        <% const chipStyles = [ "bg-emerald-500/10 border-emerald-500/25 text-emerald-300", "bg-violet-500/10 border-violet-500/25 text-violet-300", "bg-sky-500/10 border-sky-500/25 text-sky-300", "bg-fox-500/10 border-fox-500/25 text-fox-300" ]; %>
        <% const pillarTags = ["MCP SERVERS", "12 TOOLS", "SSH OPS"]; %>
        <% const toolStats = ["8", "30", "12"]; %>

        <div class="text-center mb-10 sm:mb-14">
          <div
            class="inline-flex items-center px-3.5 py-1.5 rounded-full bg-sky-500/10 border border-sky-500/20 text-sky-400 text-xs font-mono font-medium mb-4"
          >
            <%= t["tools.badge.0"] %>
          </div>
          <h2 class="text-2xl sm:text-4xl font-bold mb-4">
            <%= t["tools.title.0"] %>
          </h2>
          <p
            class="text-sm sm:text-base text-zinc-400 max-w-2xl mx-auto leading-relaxed"
          >
            <%= t["tools.lede.0"] %>
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-6">
          <% for (let i = 0; i < 3; i++) { %>
          <div
            class="p-6 rounded-2xl bg-zinc-900/50 border border-zinc-800/70 backdrop-blur-xl relative overflow-hidden hover:border-sky-500/40 transition-all duration-300"
          >
            <div
              class="absolute -right-8 -top-8 w-24 h-24 bg-sky-500/10 blur-2xl rounded-full pointer-events-none"
            ></div>
            <div
              class="text-[10px] font-mono text-sky-400 uppercase tracking-widest mb-3 relative z-10"
            >
              <%= pillarTags[i] %>
            </div>
            <h3
              class="font-bold text-white text-sm mb-2 relative z-10"
            >
              <%= t["tools.pillars." + i + ".title.0"] %>
            </h3>
            <p
              class="text-xs text-zinc-400 leading-relaxed relative z-10"
            >
              <%= t["tools.pillars." + i + ".body.0"] %>
            </p>
          </div>
          <% } %>
        </div>

        <div
          class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 mb-6 p-4 sm:p-5 rounded-2xl bg-zinc-950/60 border border-zinc-800/70"
        >
          <span
            class="px-3 py-1.5 rounded-lg bg-sky-500/10 border border-sky-500/25 text-sky-300 text-[10px] sm:text-xs font-mono font-bold"
            >MODEL</span
          >
          <svg
            class="w-4 h-4 text-zinc-600"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
            ></path>
          </svg>
          <span
            class="px-3 py-1.5 rounded-lg bg-violet-500/10 border border-violet-500/25 text-violet-300 text-[10px] sm:text-xs font-mono font-bold"
            >TOOL CALL</span
          >
          <svg
            class="w-4 h-4 text-zinc-600"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
            ></path>
          </svg>
          <span
            class="px-3 py-1.5 rounded-lg bg-emerald-500/10 border border-emerald-500/25 text-emerald-300 text-[10px] sm:text-xs font-mono font-bold"
            >RESULT</span
          >
          <svg
            class="w-4 h-4 text-zinc-600"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.182 3.182m0-4.991v4.991"
            ></path>
          </svg>
          <span
            class="px-3 py-1.5 rounded-lg bg-fox-500/10 border border-fox-500/25 text-fox-300 text-[10px] sm:text-xs font-mono font-bold"
            ><%= t["tools.loop.0"] %></span
          >
        </div>

        <div
          class="p-5 sm:p-8 rounded-3xl bg-zinc-950/60 border border-zinc-800/70 backdrop-blur-xl"
        >
          <div class="flex flex-wrap items-center justify-between gap-2 mb-5">
            <div
              class="text-xs font-mono uppercase tracking-widest text-zinc-300"
            >
              <%= t["tools.grid.title.0"] %>
            </div>
            <div class="text-[10px] font-mono text-sky-400">
              <%= t["tools.grid.meta.0"] %>
            </div>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-2.5">
            <% for (const [name, kind] of toolChips) { %>
            <div
              class="flex items-center justify-between gap-2 px-3 py-2.5 rounded-xl bg-zinc-900/60 border border-zinc-800/70"
            >
              <span
                class="text-[11px] font-mono font-semibold text-zinc-200 truncate"
                ><%= name %></span
              >
              <span
                class="flex-shrink-0 text-[9px] font-mono px-1.5 py-0.5 rounded-md border <%= chipStyles[kind] %>"
                ><%= t["tools.legend." + kind + ".0"] %></span
              >
            </div>
            <% } %>
          </div>
        </div>

        <div class="grid grid-cols-3 gap-3 sm:gap-4 mt-6">
          <% for (let i = 0; i < 3; i++) { %>
          <div
            class="p-4 rounded-2xl bg-zinc-900/40 border border-zinc-800/70 text-center"
          >
            <div
              class="text-xl sm:text-2xl font-extrabold text-white mb-1"
            >
              <%= toolStats[i] %>
            </div>
            <div
              class="text-[10px] sm:text-xs text-zinc-400 leading-relaxed"
            >
              <%= t["tools.stats." + i + ".body.0"] %>
            </div>
          </div>
          <% } %>
        </div>
      </section>

      <!-- Providers Section -->
      <section
        id="providers"
        class="max-w-5xl mx-auto px-4 sm:px-6 py-12 sm:py-20 relative z-10"
      >
        <div class="text-center mb-10 sm:mb-14">
          <div
            class="inline-flex items-center px-3.5 py-1.5 rounded-full bg-sky-500/10 border border-sky-500/20 text-sky-400 text-xs font-mono font-medium mb-4"
          >
            <%= t["providers.badge.0"] %>
          </div>
          <h2 class="text-2xl sm:text-4xl font-bold mb-4">
            <%= t["providers.title.0"] %>
          </h2>
          <p
            class="text-sm sm:text-base text-zinc-400 max-w-2xl mx-auto leading-relaxed"
          >
            <%= t["providers.lede.0"] %>
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-4xl mx-auto">
          <% for (let i = 0; i < 4; i++) { %>
          <div
            class="p-6 rounded-2xl bg-zinc-900/40 border border-zinc-800/70 backdrop-blur-xl hover:border-sky-500/40 transition-all duration-300"
          >
            <div
              class="text-[10px] font-mono text-sky-400 uppercase tracking-widest mb-2"
            >
              <%= t["providers.groups." + i + ".name.0"] %>
            </div>
            <p class="text-sm text-zinc-300 font-medium leading-relaxed">
              <%= t["providers.groups." + i + ".items.0"] %>
            </p>
          </div>
          <% } %>
        </div>

        <div
          class="mt-6 p-5 sm:p-7 rounded-2xl bg-sky-500/5 border border-sky-500/20 backdrop-blur-xl"
        >
          <div
            class="text-[10px] font-mono text-sky-400 uppercase tracking-widest mb-3"
          >
            <%= t["providers.native.badge.0"] %>
          </div>
          <h3 class="text-base sm:text-lg font-bold text-white mb-2">
            <%= t["providers.native.title.0"] %>
          </h3>
          <p class="text-xs sm:text-sm text-zinc-400 leading-relaxed mb-5">
            <%= t["providers.native.body.0"] %>
          </p>
          <div class="flex flex-wrap gap-2">
            <% for (const label of ["Anthropic Messages", "Gemini generateContent", "Ollama /api/chat", "llama.cpp in-process", "Azure deployment", "MiniMax intl / CN", "Per-provider scopes"]) { %>
            <span
              class="px-2.5 py-1 rounded-lg bg-zinc-900/70 border border-zinc-800 text-[10px] font-mono text-zinc-300"
              ><%= label %></span
            >
            <% } %>
          </div>
        </div>
      </section>

      <!-- Pricing Section -->
      <section
        id="pricing"
        class="max-w-5xl mx-auto px-4 sm:px-6 py-12 sm:py-20 relative z-10"
      >
        <div class="text-center mb-10 sm:mb-14">
          <div
            class="inline-flex items-center px-3.5 py-1.5 rounded-full bg-sky-500/10 border border-sky-500/20 text-sky-400 text-xs font-mono font-medium mb-4"
          >
            <%= t["pricing.badge.0"] %>
          </div>
          <h2 class="text-2xl sm:text-4xl font-bold mb-4">
            <%= t["pricing.title.0"] %>
          </h2>
          <p
            class="text-sm sm:text-base text-zinc-400 max-w-2xl mx-auto leading-relaxed"
          >
            <%= t["pricing.lede.0"] %>
          </p>
        </div>

        <div
          class="max-w-md mx-auto p-8 rounded-3xl bg-zinc-900/60 border border-sky-500/30 backdrop-blur-xl relative overflow-hidden shadow-2xl"
        >
          <div
            class="absolute -right-10 -top-10 w-48 h-48 bg-sky-500/15 blur-[70px] rounded-full pointer-events-none"
          ></div>
          <div
            class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-sky-400/50 to-transparent"
          ></div>
          <div class="flex items-baseline justify-between mb-1 relative z-10">
            <span
              class="text-4xl sm:text-5xl font-extrabold ai-gradient-text"
              ><%= t["pricing.free.price.0"] %></span
            >
            <span
              class="px-2.5 py-1 rounded-md bg-sky-500/15 border border-sky-500/30 text-sky-400 text-xs font-bold"
              ><%= t["pricing.free.tag.0"] %></span
            >
          </div>
          <h3 class="text-lg font-bold text-white mt-4 relative z-10">
            <%= t["pricing.free.name.0"] %>
          </h3>
          <p class="text-sm text-zinc-400 mb-6 relative z-10">
            <%= t["pricing.free.lede.0"] %>
          </p>
          <ul class="space-y-2.5 mb-8 relative z-10">
            <% for (let i = 0; i < 3; i++) { %>
            <li class="flex items-start space-x-2.5 text-sm text-zinc-300">
              <svg
                class="w-4 h-4 mt-0.5 text-sky-400 flex-shrink-0"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M4.5 12.75l6 6 9-13.5"
                ></path>
              </svg>
              <span><%= t["pricing.free.items." + i + ".0"] %></span>
            </li>
            <% } %>
          </ul>
          <a
            href="https://apps.apple.com/us/app/uchat-ai/id6503210454"
            target="_blank"
            rel="noopener noreferrer"
            class="relative z-10 block text-center w-full py-3.5 rounded-xl bg-sky-500 hover:bg-sky-400 text-white font-semibold text-sm transition-all shadow-lg shadow-sky-500/25"
          >
            <%= t["pricing.free.button.0"] %>
          </a>
        </div>

        <p
          class="text-center text-xs text-zinc-500 mt-6 max-w-xl mx-auto"
        >
          <%= t["pricing.note.0"] %>
        </p>
      </section>

      <!-- FAQ Section -->
      <section
        id="faq"
        class="max-w-3xl mx-auto px-4 sm:px-6 py-12 sm:py-20 relative z-10"
      >
        <div class="text-center mb-10 sm:mb-14">
          <div
            class="inline-flex items-center px-3.5 py-1.5 rounded-full bg-sky-500/10 border border-sky-500/20 text-sky-400 text-xs font-mono font-medium mb-4"
          >
            <%= t["faq.badge.0"] %>
          </div>
          <h2 class="text-2xl sm:text-4xl font-bold mb-4">
            <%= t["faq.title.0"] %>
          </h2>
          <p
            class="text-sm sm:text-base text-zinc-400 max-w-2xl mx-auto leading-relaxed"
          >
            <%= t["faq.lede.0"] %>
          </p>
        </div>

        <div class="space-y-3">
          <% for (let i = 0; i < 5; i++) { %>
          <details
            class="group rounded-2xl bg-zinc-900/40 border border-zinc-800/70 backdrop-blur-xl open:border-sky-500/30 transition-colors"
          >
            <summary
              class="flex items-center justify-between cursor-pointer list-none p-5 text-sm sm:text-base font-semibold text-zinc-100"
            >
              <span><%= t["faq.items." + i + ".q.0"] %></span>
              <svg
                class="w-4 h-4 text-zinc-500 flex-shrink-0 ml-4 transition-transform duration-200 group-open:rotate-45"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 4v16m8-8H4"
                ></path>
              </svg>
            </summary>
            <div
              class="px-5 pb-5 text-xs sm:text-sm text-zinc-400 leading-relaxed"
            >
              <p><%= t["faq.items." + i + ".a.0"] %></p>
            </div>
          </details>
          <% } %>
        </div>
      </section>

      <!-- Download Section -->
      <section
        id="download"
        class="max-w-4xl mx-auto px-4 sm:px-6 py-12 sm:py-20 text-center relative z-10"
      >
        <div
          class="p-8 sm:p-12 rounded-2xl sm:rounded-3xl bg-zinc-900 border border-zinc-800 relative overflow-hidden hover:border-sky-500/40 transition-all duration-300"
        >
          <div
            class="absolute -right-10 -top-10 w-48 sm:w-64 h-48 sm:h-64 bg-sky-500/20 blur-[60px] sm:blur-[80px] rounded-full pointer-events-none"
          ></div>
          <h2 class="text-2xl sm:text-3xl font-bold mb-3 sm:mb-4 relative z-10">
            <%= t["download.title.0"] %>
          </h2>
          <p
            class="text-xs sm:text-base text-zinc-400 mb-6 sm:mb-8 max-w-lg mx-auto relative z-10"
          >
            <%= t["download.subtitle.0"] %>
          </p>
          <div class="flex items-center justify-center relative z-10">
            <a
              href="https://apps.apple.com/us/app/uchat-ai/id6503210454"
              target="_blank"
              rel="noopener noreferrer"
              class="bg-sky-500 hover:bg-sky-400 text-white font-semibold px-7 py-4 rounded-xl transition-all shadow-lg shadow-sky-500/25 flex items-center space-x-3 text-sm sm:text-base"
            >
              <img
                src="/assets/apple.svg"
                alt="<%= t["download.button.alt"] %>"
                class="w-6 h-6 flex-shrink-0 brightness-0 invert object-contain"
              />
              <span><%= t["download.button.label.0"] %></span>
            </a>
          </div>

          <!-- System Requirements -->
          <div
            class="mt-8 sm:mt-10 pt-6 sm:pt-8 border-t border-zinc-800/80 grid grid-cols-2 gap-4 text-left relative z-10"
          >
            <% for (let i = 0; i < 2; i++) { %>
            <div>
              <div
                class="text-[10px] font-mono uppercase tracking-widest text-zinc-500 mb-1"
              >
                <%= t["download.reqs." + i + ".label.0"] %>
              </div>
              <div class="text-xs sm:text-sm text-zinc-300 font-medium">
                <%= t["download.reqs." + i + ".value.0"] %>
              </div>
            </div>
            <% } %>
          </div>

          <p
            class="text-center text-[11px] text-zinc-500 mt-6 max-w-xl mx-auto relative z-10"
          >
            <%= t["download.note.0"] %>
            <a
              href="/privacy"
              class="text-sky-400 hover:underline"
              ><%= t["download.legal.0.0"] %></a
            ><%= t["download.legalSep.0"] %>
            <a
              href="/terms"
              class="text-sky-400 hover:underline"
              ><%= t["download.legal.1.0"] %></a
            ><%= t["download.noteEnd.0"] %>
          </p>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <%- footer %>

    <script src="/assets/script.js" charset="utf-8"></script>
  </body>
</html>
