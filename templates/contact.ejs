<!doctype html>
<html lang="<%- htmlLang %>" class="dark scroll-smooth">
  <%- head %>

  <body
    class="bg-zinc-950 text-zinc-100 font-sans antialiased selection:bg-fox-500 selection:text-white overflow-x-hidden"
  >
    <!-- Ambient Background Lighting -->
    <div class="fixed inset-0 w-full h-full pointer-events-none z-0">
      <div
        class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-[1200px] h-[600px] bg-fox-500/15 blur-[140px] md:blur-[180px] rounded-full z-0 transform-gpu translate-z-0"
      ></div>
      <div
        class="absolute top-1/3 -right-20 w-[400px] h-[400px] bg-fox-500/10 blur-[150px] rounded-full z-0 transform-gpu translate-z-0"
      ></div>
      <div
        class="absolute inset-0 w-full h-full opacity-20 bg-code-grid [mask-image:radial-gradient(ellipse_at_center,black_20%,transparent_80%)] [-webkit-mask-image:radial-gradient(ellipse_at_center,black_20%,transparent_80%)]"
      ></div>
    </div>

    <!-- Navigation -->
    <%- nav %>

    <!-- Main Content -->
    <main class="relative z-10 max-w-3xl mx-auto px-4 sm:px-6 py-12 sm:py-20">
      <!-- Header -->
      <div class="mb-10 text-left">
        <div
          class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-fox-500/10 border border-fox-500/20 text-fox-500 text-xs font-mono font-medium mb-6"
        >
          <span
            class="w-1.5 h-1.5 rounded-full bg-fox-500 animate-pulse"
          ></span>
          <span><%= t["content.badge.0"] %></span>
        </div>
        <h1
          class="text-3xl sm:text-5xl font-extrabold tracking-tight mb-4 text-white"
        >
          <%= t["content.title.0"] %> <br /><span class="orange-gradient-text"
            ><%= t["content.title.1"] %></span
          >
        </h1>
        <p class="text-zinc-400 text-sm sm:text-base leading-relaxed">
          <%= t["content.lede.0"] %>
        </p>
      </div>

      <!-- Support Card -->
      <div
        class="p-6 sm:p-10 rounded-3xl bg-zinc-900/50 border border-zinc-800 backdrop-blur-xl relative overflow-hidden mb-12 shadow-2xl"
      >
        <div
          class="absolute -right-10 -bottom-10 w-64 h-64 bg-fox-500/10 blur-[90px] rounded-full pointer-events-none"
        ></div>

        <p class="text-zinc-300 text-sm sm:text-base leading-relaxed mb-8">
          <%= t["content.lede.1"] %>
        </p>

        <!-- Interactive Email Box (Fixed & Upgraded) -->
        <div
          class="p-6 sm:p-8 rounded-2xl bg-zinc-950/90 border border-zinc-800/80 flex flex-col md:flex-row items-start md:items-center justify-between gap-6 shadow-2xl relative overflow-hidden group"
        >
          <div
            class="absolute -right-12 -top-12 w-40 h-40 bg-fox-500/10 blur-2xl rounded-full pointer-events-none"
          ></div>

          <div class="flex items-center space-x-4 relative z-10">
            <div
              class="w-12 h-12 rounded-xl bg-fox-500/10 border border-fox-500/25 flex items-center justify-center text-fox-500 flex-shrink-0 shadow-[0_0_15px_rgba(255,104,0,0.15)]"
            >
              <svg
                class="w-6 h-6 shrink-0"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
                ></path>
              </svg>
            </div>
            <div class="flex flex-col justify-center">
              <span
                class="text-[11px] font-mono text-zinc-500 uppercase tracking-widest mb-1"
                ><%= t["content.sections.-1.specs.0.label.0"] %></span
              >
              <a
                href="mailto:support@foxterm.app"
                class="text-lg sm:text-xl font-mono font-bold text-white hover:text-fox-400 transition-colors tracking-tight"
              >
                <%= t["content.links.0.0"] %>
              </a>
            </div>
          </div>

          <a
            href="mailto:support@foxterm.app"
            class="relative z-10 shrink-0 w-full md:w-auto px-6 py-3 rounded-xl bg-fox-500 hover:bg-fox-600 border border-fox-400/30 text-white font-semibold text-xs sm:text-sm transition-all duration-300 shadow-[0_0_20px_rgba(255,94,0,0.3)] hover:shadow-[0_0_28px_rgba(255,94,0,0.5)] active:scale-95 flex items-center justify-center gap-2 group/btn"
          >
            <span><%= t["content.links.1.0"] %></span>
            <svg
              class="w-4 h-4 shrink-0 transition-transform duration-300 group-hover/btn:translate-x-1"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
              ></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Guidance Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div
          class="p-5 rounded-2xl bg-zinc-900/30 border border-zinc-800/60 group hover:border-fox-500/40 hover:-translate-y-0.5 hover:shadow-[0_0_24px_-8px_rgba(255,104,0,0.35)] transition-all duration-300"
        >
          <div
            class="text-fox-500 font-mono font-bold text-xs mb-2 transition-all duration-300 group-hover:drop-shadow-[0_0_6px_rgba(255,104,0,0.5)]"
          >
            <%= t["content.cards.0.title.0"] %>
          </div>
          <p class="text-xs text-zinc-400 leading-relaxed">
            <%= t["content.cards.0.body.0"] %>
          </p>
        </div>
        <div
          class="p-5 rounded-2xl bg-zinc-900/30 border border-zinc-800/60 group hover:border-fox-500/40 hover:-translate-y-0.5 hover:shadow-[0_0_24px_-8px_rgba(255,104,0,0.35)] transition-all duration-300"
        >
          <div
            class="text-fox-500 font-mono font-bold text-xs mb-2 transition-all duration-300 group-hover:drop-shadow-[0_0_6px_rgba(255,104,0,0.5)]"
          >
            <%= t["content.cards.1.title.0"] %>
          </div>
          <p class="text-xs text-zinc-400 leading-relaxed">
            <%= t["content.cards.1.body.0"] %>
          </p>
        </div>
        <div
          class="p-5 rounded-2xl bg-zinc-900/30 border border-zinc-800/60 group hover:border-fox-500/40 hover:-translate-y-0.5 hover:shadow-[0_0_24px_-8px_rgba(255,104,0,0.35)] transition-all duration-300"
        >
          <div
            class="text-fox-500 font-mono font-bold text-xs mb-2 transition-all duration-300 group-hover:drop-shadow-[0_0_6px_rgba(255,104,0,0.5)]"
          >
            <%= t["content.cards.2.title.0"] %>
          </div>
          <p class="text-xs text-zinc-400 leading-relaxed">
            <%= t["content.cards.2.body.0"] %>
          </p>
        </div>
      </div>

      <!-- Commission Section: Contract Work -->
      <section class="mt-16 sm:mt-24 mb-12">
        <div
          class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-fox-500/10 border border-fox-500/20 text-fox-500 text-xs font-mono font-medium mb-6"
        >
          <span
            class="w-1.5 h-1.5 rounded-full bg-fox-500 animate-pulse"
          ></span>
          <span><%= t["content.sections.0.badge.0"] %></span>
        </div>

        <h2
          class="text-2xl sm:text-4xl font-extrabold tracking-tight mb-4 text-white"
        >
          <%= t["content.sections.0.title.0"] %>
          <span class="orange-gradient-text"><%= t["content.sections.0.title.1"] %></span><%= t["content.sections.0.title.2"] || "" %>
        </h2>
        <p class="text-zinc-400 text-sm sm:text-base leading-relaxed mb-8">
          <%= t["content.sections.0.body.0"] %>
        </p>

        <!-- Capability Pillars -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
          <div
            class="p-5 rounded-2xl bg-zinc-900/40 border border-zinc-800/70 backdrop-blur-xl relative overflow-hidden group hover:border-fox-500/40 hover:-translate-y-0.5 hover:shadow-[0_0_24px_-8px_rgba(255,104,0,0.35)] transition-all duration-300"
          >
            <div
              class="text-fox-500 font-mono font-bold text-xs mb-1 transition-all duration-300 group-hover:drop-shadow-[0_0_6px_rgba(255,104,0,0.5)]"
            >
              <%= t["content.sections.0.label.0"] %>
            </div>
            <div
              class="text-[10px] font-mono text-zinc-500 uppercase tracking-widest mb-4"
            >
              <%= t["content.sections.0.specs.0.label.0"] %>
            </div>
            <ul class="space-y-3">
              <li>
                <div class="font-mono font-bold text-sm text-white"><%= t["content.sections.0.specs.0.value.0"] %></div>
                <p class="text-xs text-zinc-400 leading-relaxed mt-0.5">
                  <%= t["content.sections.0.body.1"] %>
                </p>
              </li>
              <li>
                <div class="font-mono font-bold text-sm text-white">
                  <%= t["content.sections.0.specs.0.value.1"] %>
                </div>
                <p class="text-xs text-zinc-400 leading-relaxed mt-0.5">
                  <%= t["content.sections.0.body.2"] %>
                </p>
              </li>
            </ul>
          </div>

          <div
            class="p-5 rounded-2xl bg-zinc-900/40 border border-zinc-800/70 backdrop-blur-xl relative overflow-hidden group hover:border-fox-500/40 hover:-translate-y-0.5 hover:shadow-[0_0_24px_-8px_rgba(255,104,0,0.35)] transition-all duration-300"
          >
            <div
              class="text-fox-500 font-mono font-bold text-xs mb-1 transition-all duration-300 group-hover:drop-shadow-[0_0_6px_rgba(255,104,0,0.5)]"
            >
              <%= t["content.sections.0.label.1"] %>
            </div>
            <div
              class="text-[10px] font-mono text-zinc-500 uppercase tracking-widest mb-4"
            >
              <%= t["content.sections.0.specs.1.label.0"] %>
            </div>
            <ul class="space-y-3">
              <li>
                <div class="font-mono font-bold text-sm text-white"><%= t["content.sections.0.specs.1.value.0"] %></div>
                <p class="text-xs text-zinc-400 leading-relaxed mt-0.5">
                  <%= t["content.sections.0.body.3"] %>
                </p>
              </li>
              <li>
                <div class="font-mono font-bold text-sm text-white"><%= t["content.sections.0.specs.1.value.1"] %></div>
                <p class="text-xs text-zinc-400 leading-relaxed mt-0.5">
                  <%= t["content.sections.0.body.4"] %>
                </p>
              </li>
            </ul>
          </div>

          <div
            class="p-5 rounded-2xl bg-zinc-900/40 border border-zinc-800/70 backdrop-blur-xl relative overflow-hidden group hover:border-fox-500/40 hover:-translate-y-0.5 hover:shadow-[0_0_24px_-8px_rgba(255,104,0,0.35)] transition-all duration-300"
          >
            <div
              class="text-fox-500 font-mono font-bold text-xs mb-1 transition-all duration-300 group-hover:drop-shadow-[0_0_6px_rgba(255,104,0,0.5)]"
            >
              <%= t["content.sections.0.label.2"] %>
            </div>
            <div
              class="text-[10px] font-mono text-zinc-500 uppercase tracking-widest mb-4"
            >
              <%= t["content.sections.0.specs.2.label.0"] %>
            </div>
            <ul class="space-y-3">
              <li>
                <div class="font-mono font-bold text-sm text-white"><%= t["content.sections.0.specs.2.value.0"] %></div>
                <p class="text-xs text-zinc-400 leading-relaxed mt-0.5">
                  <%= t["content.sections.0.body.5"] %>
                </p>
              </li>
              <li>
                <div class="font-mono font-bold text-sm text-white"><%= t["content.sections.0.specs.2.value.1"] %></div>
                <p class="text-xs text-zinc-400 leading-relaxed mt-0.5">
                  <%= t["content.sections.0.body.6"] %>
                </p>
              </li>
            </ul>
          </div>
        </div>

        <!-- Engagement Process -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
          <div
            class="p-5 rounded-2xl bg-zinc-900/30 border border-zinc-800/60 group hover:border-fox-500/40 hover:-translate-y-0.5 hover:shadow-[0_0_24px_-8px_rgba(255,104,0,0.35)] transition-all duration-300"
          >
            <div
              class="text-fox-500 font-mono font-bold text-xs mb-2 transition-all duration-300 group-hover:drop-shadow-[0_0_6px_rgba(255,104,0,0.5)]"
            >
              <%= t["content.sections.0.label.3"] %>
            </div>
            <p class="text-xs text-zinc-400 leading-relaxed">
              <%= t["content.sections.0.body.7"] %>
            </p>
          </div>
          <div
            class="p-5 rounded-2xl bg-zinc-900/30 border border-zinc-800/60 group hover:border-fox-500/40 hover:-translate-y-0.5 hover:shadow-[0_0_24px_-8px_rgba(255,104,0,0.35)] transition-all duration-300"
          >
            <div
              class="text-fox-500 font-mono font-bold text-xs mb-2 transition-all duration-300 group-hover:drop-shadow-[0_0_6px_rgba(255,104,0,0.5)]"
            >
              <%= t["content.sections.0.label.4"] %>
            </div>
            <p class="text-xs text-zinc-400 leading-relaxed">
              <%= t["content.sections.0.body.8"] %>
            </p>
          </div>
          <div
            class="p-5 rounded-2xl bg-zinc-900/30 border border-zinc-800/60 group hover:border-fox-500/40 hover:-translate-y-0.5 hover:shadow-[0_0_24px_-8px_rgba(255,104,0,0.35)] transition-all duration-300"
          >
            <div
              class="text-fox-500 font-mono font-bold text-xs mb-2 transition-all duration-300 group-hover:drop-shadow-[0_0_6px_rgba(255,104,0,0.5)]"
            >
              <%= t["content.sections.0.label.5"] %>
            </div>
            <p class="text-xs text-zinc-400 leading-relaxed">
              <%= t["content.sections.0.body.9"] %>
            </p>
          </div>
          <div
            class="p-5 rounded-2xl bg-zinc-900/30 border border-zinc-800/60 group hover:border-fox-500/40 hover:-translate-y-0.5 hover:shadow-[0_0_24px_-8px_rgba(255,104,0,0.35)] transition-all duration-300"
          >
            <div
              class="text-fox-500 font-mono font-bold text-xs mb-2 transition-all duration-300 group-hover:drop-shadow-[0_0_6px_rgba(255,104,0,0.5)]"
            >
              <%= t["content.sections.0.label.6"] %>
            </div>
            <p class="text-xs text-zinc-400 leading-relaxed">
              <%= t["content.sections.0.body.10"] %>
            </p>
          </div>
        </div>

        <!-- Commission CTA Card -->
        <div
          class="p-6 sm:p-8 rounded-3xl bg-zinc-900/50 border border-zinc-800 backdrop-blur-xl relative overflow-hidden shadow-2xl"
        >
          <div
            class="absolute -right-10 -bottom-10 w-64 h-64 bg-fox-500/10 blur-[90px] rounded-full pointer-events-none"
          ></div>

          <p class="text-zinc-300 text-sm sm:text-base leading-relaxed mb-6">
            <%= t["content.sections.0.body.11"] %>
          </p>

          <div
            class="p-6 sm:p-8 rounded-2xl bg-zinc-950/90 border border-zinc-800/80 flex flex-col md:flex-row items-start md:items-center justify-between gap-6 shadow-2xl relative overflow-hidden group"
          >
            <div
              class="absolute -right-12 -top-12 w-40 h-40 bg-fox-500/10 blur-2xl rounded-full pointer-events-none"
            ></div>

            <div class="flex items-center space-x-4 relative z-10">
              <div
                class="w-12 h-12 rounded-xl bg-fox-500/10 border border-fox-500/25 flex items-center justify-center text-fox-500 flex-shrink-0 shadow-[0_0_15px_rgba(255,104,0,0.15)]"
              >
                <svg
                  class="w-6 h-6 shrink-0"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M20.25 14.15v4.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25v-4.25m16.5 0a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003.75 14.15m16.5 0v-3.9a2.25 2.25 0 00-2.25-2.25H6a2.25 2.25 0 00-2.25 2.25v3.9m3 4.35h.008M12 8.25h.008M15.75 8.25h.008"
                  ></path>
                </svg>
              </div>
              <div class="flex flex-col justify-center">
                <span
                  class="text-[11px] font-mono text-zinc-500 uppercase tracking-widest mb-1"
                  ><%= t["content.sections.0.specs.3.label.0"] %></span
                >
                <a
                  href="mailto:foxterm@icloud.com"
                  class="text-lg sm:text-xl font-mono font-bold text-white hover:text-fox-400 transition-colors tracking-tight"
                >
                  <%= t["content.sections.0.links.0.0"] %>
                </a>
              </div>
            </div>

            <a
              href="mailto:foxterm@icloud.com?subject=Project%20Inquiry"
              class="relative z-10 shrink-0 w-full md:w-auto px-6 py-3 rounded-xl bg-fox-500 hover:bg-fox-600 border border-fox-400/30 text-white font-semibold text-xs sm:text-sm transition-all duration-300 shadow-[0_0_20px_rgba(255,94,0,0.3)] hover:shadow-[0_0_28px_rgba(255,94,0,0.5)] active:scale-95 flex items-center justify-center gap-2 group/btn"
            >
              <span><%= t["content.sections.0.links.1.0"] %></span>
              <svg
                class="w-4 h-4 shrink-0 transition-transform duration-300 group-hover/btn:translate-x-1"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
                ></path>
              </svg>
            </a>
          </div>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <%- footer %>

    <script src="/assets/script.js" charset="utf-8"></script>
  </body>
</html>
