<!doctype html>
<html lang="<%- htmlLang %>" class="dark scroll-smooth">
  <%- head %>

  <body
    class="bg-zinc-950 text-zinc-100 font-sans antialiased selection:bg-fox-500 selection:text-white overflow-x-hidden"
  >
    <!-- Ambient Background -->
    <div class="fixed inset-0 w-full h-full pointer-events-none z-0">
      <div
        class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-[1200px] h-[600px] bg-fox-500/15 blur-[140px] md:blur-[180px] rounded-full z-0 transform-gpu translate-z-0"
      ></div>
      <div
        class="absolute top-1/3 -right-20 w-[400px] h-[400px] bg-fox-500/10 blur-[150px] rounded-full z-0 transform-gpu translate-z-0"
      ></div>
      <div
        class="absolute inset-0 w-full h-full opacity-20 bg-code-grid [mask-image:radial-gradient(ellipse_at_center,black_20%,transparent_80%)] [-webkit-mask-image:radial-gradient(ellipse_at_center,black_20%,transparent_80%)]"
      ></div>
    </div>

    <!-- Navigation -->
    <%- nav %>

    <!-- Privacy Policy Content -->
    <main class="relative z-10 max-w-3xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
      <div class="mb-10">
        <div
          class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-fox-500/10 border border-fox-500/20 text-fox-500 text-xs font-mono font-medium mb-6"
        >
          <%= t["content.badge.0"] %>
        </div>
        <h1
          class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-4 text-white"
        >
          <%= t["content.title.0"] %>
        </h1>
        <p class="text-zinc-400 text-sm"><%= t["content.lede.0"] %></p>
      </div>

      <div
        class="prose prose-invert max-w-none space-y-8 text-zinc-300 text-sm sm:text-base leading-relaxed"
      >
        <div class="p-6 rounded-2xl bg-fox-500/10 border border-fox-500/20">
          <h2 class="text-lg font-bold text-fox-400 mb-3 mt-0">
            <%= t["content.commitment.title.0"] %>
          </h2>
          <p class="m-0 text-zinc-300">
            <%= t["content.commitment.body.0"] %>
            <strong><%= t["content.commitment.body.2"] %></strong>
            <%= t["content.commitment.body.1"] %>
          </p>
        </div>

        <section>
          <h2 class="text-xl font-bold text-white mb-4 mt-8">
            <%= t["content.sections.0.title.0"] %>
          </h2>
          <p><%= t["content.sections.0.body.0"] %></p>
          <ul class="list-disc pl-6 space-y-2 text-zinc-400">
            <li><%= t["content.sections.0.items.0.0"] %></li>
            <li><%= t["content.sections.0.items.1.0"] %></li>
            <li><%= t["content.sections.0.items.2.0"] %></li>
            <li>
              <%= t["content.sections.0.items.3.0"] %>
            </li>
            <li>
              <%= t["content.sections.0.items.4.0"] %>
            </li>
          </ul>
        </section>

        <section>
          <h2 class="text-xl font-bold text-white mb-4 mt-8">
            <%= t["content.sections.1.title.0"] %>
          </h2>
          <p><%= t["content.sections.1.body.0"] %></p>
          <ul class="list-disc pl-6 space-y-2 text-zinc-400">
            <li>
              <strong class="text-zinc-200"
                ><%= t["content.sections.1.items.0.1"] %></strong
              >
              <%= t["content.sections.1.items.0.0"] %>
            </li>
            <li>
              <strong class="text-zinc-200"
                ><%= t["content.sections.1.items.1.1"] %></strong
              >
              <%= t["content.sections.1.items.1.0"] %>
            </li>
            <li>
              <strong class="text-zinc-200"
                ><%= t["content.sections.1.items.2.1"] %></strong
              >
              <%= t["content.sections.1.items.2.0"] %>
            </li>
          </ul>
        </section>

        <section>
          <h2 class="text-xl font-bold text-white mb-4 mt-8">
            <%= t["content.sections.2.title.0"] %>
          </h2>
          <p><%= t["content.sections.2.body.0"] %></p>
          <ul class="list-disc pl-6 space-y-2 text-zinc-400">
            <li>
              <%= t["content.sections.2.items.0.0"] %>
            </li>
            <li>
              <%= t["content.sections.2.items.1.0"] %>
            </li>
            <li>
              <%= t["content.sections.2.items.2.0"] %>
            </li>
            <li>
              <%= t["content.sections.2.items.3.0"] %>
            </li>
          </ul>
        </section>

        <section>
          <h2 class="text-xl font-bold text-white mb-4 mt-8">
            <%= t["content.sections.3.title.0"] %>
          </h2>
          <p><%= t["content.sections.3.body.0"] %></p>
          <ul class="list-disc pl-6 space-y-2 text-zinc-400">
            <li>
              <%= t["content.sections.3.items.0.0"] %>
            </li>
            <li>
              <%= t["content.sections.3.items.1.0"] %>
            </li>
            <li>
              <%= t["content.sections.3.items.2.0"] %>
              <strong><%= t["content.sections.3.items.2.2"] %></strong>
              <%= t["content.sections.3.items.2.1"] %>
            </li>
            <li>
              <%= t["content.sections.3.items.3.0"] %>
            </li>
          </ul>
        </section>

        <section>
          <h2 class="text-xl font-bold text-white mb-4 mt-8">
            <%= t["content.sections.4.title.0"] %>
          </h2>
          <p><%= t["content.sections.4.body.0"] %></p>
          <ul class="list-disc pl-6 space-y-2 text-zinc-400">
            <li><%= t["content.sections.4.items.0.0"] %></li>
            <li><%= t["content.sections.4.items.1.0"] %></li>
            <li>
              <%= t["content.sections.4.items.2.0"] %>
            </li>
            <li>
              <%= t["content.sections.4.items.3.0"] %>
            </li>
          </ul>
        </section>

        <section>
          <h2 class="text-xl font-bold text-white mb-4 mt-8">
            <%= t["content.sections.5.title.0"] %>
          </h2>
          <p><%= t["content.sections.5.body.0"] %></p>
          <ul class="list-disc pl-6 space-y-2 text-zinc-400">
            <li>
              <%= t["content.sections.5.items.0.0"] %>
            </li>
            <li>
              <%= t["content.sections.5.items.1.0"] %>
            </li>
          </ul>
        </section>

        <section>
          <h2 class="text-xl font-bold text-white mb-4 mt-8">
            <%= t["content.sections.6.title.0"] %>
          </h2>
          <p><%= t["content.sections.6.body.0"] %></p>
        </section>

        <section>
          <h2 class="text-xl font-bold text-white mb-4 mt-8">
            <%= t["content.sections.7.title.0"] %>
          </h2>
          <p><%= t["content.sections.7.body.0"] %></p>
        </section>

        <section>
          <h2 class="text-xl font-bold text-white mb-4 mt-8">
            <%= t["content.sections.8.title.0"] %>
          </h2>
          <p>
            <%= t["content.sections.8.body.0"] %>
            <a
              href="mailto:foxterm.app@gmail.com"
              class="text-fox-400 hover:text-fox-300 no-underline"
              ><%= t["content.sections.8.links.0.0"] %></a
            ><%= t["content.sections.8.body.1"] %>
          </p>
        </section>
      </div>
    </main>

    <!-- Footer -->
    <%- footer %>

    <script src="/assets/script.js" charset="utf-8"></script>
  </body>
</html>
